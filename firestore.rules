rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 選舉期間不公開結果：每個人（匿名登入的 uid）只能讀「自己那一張票」，
    // 不能列出或讀取別人的票；只能新增自己的一票，投出後不能修改或刪除，並且只在截止時間前有效。
    // 票數與名單只有主辦人能在 Firebase 後台（Firestore Database）查看。
    match /votes/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','choice','ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.choice in ['shen','chiang']
        && request.resource.data.ts is number
        && request.time < timestamp.date(2026, 11, 28) + duration.value(479, 'm');
      allow update, delete: if false;
    }
  }
}
