rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 主辦人後台（admin.html）：輸入正確的認證碼後，才會在 admins 集合建立「自己的」文件；有這份文件的人才能讀取全部的票
    function isAdmin() { return exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin == 'CHANGE_ME_PIN';
      allow read, update, delete: if false;
    }
    // 選舉期間不公開結果：2026/11/28 16:30（台灣時間）之前，每個人只能讀「自己那一張票」，不能列出或讀取別人的票；
    // 16:30（= 08:30 UTC = 午夜後 510 分鐘）之後才開放所有人讀取，用來公布票數與名單。
    // 只能新增自己的一票，投出後不能修改或刪除，並且只在 15:59 之前有效。
    match /votes/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || request.time >= timestamp.date(2026, 11, 28) + duration.value(510, 'm') || isAdmin());
      allow list: if request.auth != null && (request.time >= timestamp.date(2026, 11, 28) + duration.value(510, 'm') || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','choice','ts'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.choice in ['shen','chiang']
        && request.resource.data.ts is number
        && request.time < timestamp.date(2026, 11, 28) + duration.value(479, 'm');
      allow update, delete: if false;
    }
  }
}
